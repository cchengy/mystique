ANTHROPIC_API_KEY=
# Optional
MYSTIQUE_MODEL=claude-opus-5
MYSTIQUE_AGENTS_MODEL=claude-opus-5
MYSTIQUE_BUDGET_USD=5

# Required for authenticated live BYOK. Configure real values only in Dokploy.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
# Base64url encoding of exactly 32 random bytes. Inject only into credential-broker.
# Rotating it invalidates all provider credentials; keys already expire after 24h.
MYSTIQUE_VAULT_KEY=

# Optional CLI-only development overrides (see CLAUDE.md). The production Compose
# is strict BYOK and deliberately does not inject any WORLD provider key.
# MYSTIQUE_PROVIDER=openai
# MYSTIQUE_BASE_URL=
# MYSTIQUE_MODEL_ID=
# MYSTIQUE_WORLD_PROVIDER=openai
# MYSTIQUE_WORLD_BASE_URL=
# MYSTIQUE_WORLD_MODEL=
# MYSTIQUE_WORLD_API_KEY=
